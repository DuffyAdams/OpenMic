{
  "name": "openmic-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "gen:api": "node ../../scripts/gen-api-types.mjs",
    "test:e2e": "playwright test",
    "screenshots": "npm run build && node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/qrcode": "^1.5.6",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
