# Local development settings (copy to services/api/.env — it is git-ignored).
# The API reads this file automatically when started from services/api (scripts/dev.sh does).

# YouTube Data API v3 key → turns on song search. Without it, guests paste YouTube links.
# How to get one: docs/deployment.md → "Getting a YouTube API key".
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=US
