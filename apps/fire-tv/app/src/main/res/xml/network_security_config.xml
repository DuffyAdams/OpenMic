<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS is expected in production. Cleartext stays allowed so a party server on the home
     network (http://192.168.x.x:8000, LAN mode) works without certificates. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
