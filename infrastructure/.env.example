# Copy to .env (or run ./scripts/setup.sh) and fill in. Never commit .env.

# Public hostname with DNS pointing at this server → automatic HTTPS.
# Use DOMAIN=:80 for plain HTTP on a home network (LAN mode).
DOMAIN=karaoke.example.com
PUBLIC_BASE_URL=https://karaoke.example.com

# Password for host login (/admin) — pairs TVs and grants host controls.
ADMIN_PASSWORD=change-me

# Random secrets (setup.sh generates these). Hex only, 32+ chars.
SECRET_KEY=
POSTGRES_PASSWORD=

# YouTube Data API v3 key (optional). Without it, guests paste YouTube links instead of searching.
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=US
# Each search costs ~101 quota units; the default free quota is 10,000 units/day.
YOUTUBE_DAILY_SEARCH_BUDGET=90

DEFAULT_PARTY_TITLE=Karaoke Night
BACKUP_KEEP_DAYS=14
