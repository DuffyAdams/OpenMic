[Unit]
Description=Verified OpenMic PostgreSQL backup
After=postgresql@18-main.service
Requires=postgresql@18-main.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/bin/python3 /usr/local/lib/openmic/backup.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/openmic
